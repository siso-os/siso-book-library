{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sisodias/siso-book-library/manifests/schemas/book-source-1.schema.json",
  "title": "Book Library source manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifest_version",
    "source_id",
    "snapshot_id",
    "source_uri",
    "source_observed_at",
    "retrieved_at",
    "terms_revision",
    "rights_state",
    "rights_basis",
    "acquisition_method",
    "payload_path",
    "payload_sha256",
    "expected_row_contract",
    "raw_pointer_template"
  ],
  "properties": {
    "manifest_version": {"const": "book-source-1"},
    "source_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_observed_at": {"type": "string", "pattern": "Z$"},
    "retrieved_at": {"type": "string", "pattern": "Z$"},
    "terms_revision": {"type": "string", "minLength": 1},
    "rights_state": {"enum": ["public_metadata", "open_data", "restricted", "discovery_only", "pending"]},
    "rights_basis": {"type": "string", "minLength": 1},
    "acquisition_method": {"type": "string", "minLength": 1},
    "payload_path": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_pointer_template": {"type": "string", "minLength": 1},
    "expected_row_contract": {
      "type": "object",
      "required": ["required_columns", "min_rows"],
      "properties": {
        "required_columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "min_rows": {"type": "integer", "minimum": 0},
        "max_rows": {"type": "integer", "minimum": 0}
      }
    }
  }
}

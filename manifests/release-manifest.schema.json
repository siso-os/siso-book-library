{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sisodias/siso-book-library/manifests/release-manifest.schema.json",
  "title": "SISO Book Library release receipt",
  "type": "object",
  "required": [
    "manifest_version",
    "release_id",
    "created_at",
    "publication_state",
    "sources",
    "components",
    "rights_note",
    "binary_reproducibility",
    "manifest_sha256"
  ],
  "properties": {
    "manifest_version": {"const": "book-library-release-3"},
    "release_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "publication_state": {"const": "manifest_only_no_assets_uploaded"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "component_receipt_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "component_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "logical_digest": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "tar_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "row_counts": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    },
    "rights_note": {"type": "string", "minLength": 1},
    "binary_reproducibility": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
